<Window x:Class="SafeEcu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Safe ECU Calibration Manager"
        Height="720"
        MinHeight="620"
        Width="1120"
        MinWidth="980"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17202A">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="Safe ECU"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Calibration Manager"
                               Foreground="#C9D3DC"
                               FontSize="14"
                               Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl x:Name="NavigationItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Tag="{Binding Area}"
                                    Click="OnNavigationClick"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,10"
                                    Margin="0,0,0,8"
                                    Background="#22303C"
                                    Foreground="White"
                                    BorderBrush="#344756"
                                    BorderThickness="1"
                                    Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="LanguageLabel"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="LanguageSelector"
                                  Width="140"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="OnLanguageChanged" />
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="SectionTitle"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SectionDescription"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="15"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="GenericPanel"
                    Grid.Row="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D6DEE6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SectionStatus"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <TextBlock x:Name="SectionBody"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid x:Name="VehiclesPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="3*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="VehiclesListTitle"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="VehiclesEmptyText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <DataGrid x:Name="VehiclesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="OnVehicleSelectionChanged"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="VehicleMakeColumn" Binding="{Binding Make}" Width="*" />
                                <DataGridTextColumn x:Name="VehicleModelColumn" Binding="{Binding Model}" Width="*" />
                                <DataGridTextColumn x:Name="VehicleEngineCodeColumn" Binding="{Binding EngineCode}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="VehicleFormTitle"
                                           DockPanel.Dock="Left"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="NewVehicleButton"
                                            Click="OnNewVehicleClick"
                                            Padding="14,8"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="RefreshVehiclesButton"
                                            Click="OnRefreshVehiclesClick"
                                            Padding="14,8"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="SaveVehicleButton"
                                            Click="OnSaveVehicleClick"
                                            Padding="14,8"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="White" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="VehicleMessage"
                                       Foreground="#7A3E00"
                                       FontSize="13"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="VehicleProfileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="VehicleProfileSelector"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnVehicleProfileChanged"
                                      Margin="0,4,0,12" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleMakeLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleMakeTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleModelLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleModelTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleYearLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleYearTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleFuelLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="VehicleFuelSelector" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleEngineLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleEngineTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleEngineCodeLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleEngineCodeTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleVinLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleVinTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleLicensePlateLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleLicensePlateTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock x:Name="VehicleNotesLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="VehicleNotesTextBox"
                                     MinHeight="92"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock x:Name="SafeModeFooter"
                       Grid.Row="2"
                       Foreground="#7A3E00"
                       FontSize="13"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
