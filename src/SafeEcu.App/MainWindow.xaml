<Window x:Class="SafeEcu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Safe ECU Calibration Manager"
        Height="720"
        MinHeight="620"
        Width="1120"
        MinWidth="980"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17202A">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="Safe ECU"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Calibration Manager"
                               Foreground="#C9D3DC"
                               FontSize="14"
                               Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl x:Name="NavigationItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Tag="{Binding Area}"
                                    Click="OnNavigationClick"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,10"
                                    Margin="0,0,0,8"
                                    Background="#22303C"
                                    Foreground="White"
                                    BorderBrush="#344756"
                                    BorderThickness="1"
                                    Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="LanguageLabel"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="LanguageSelector"
                                  Width="140"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="OnLanguageChanged" />
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="SectionTitle"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SectionDescription"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="15"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="GenericPanel"
                    Grid.Row="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D6DEE6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SectionStatus"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <TextBlock x:Name="SectionBody"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid x:Name="VehiclesPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="3*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="VehiclesListTitle"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="VehiclesEmptyText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <DataGrid x:Name="VehiclesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="OnVehicleSelectionChanged"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="VehicleMakeColumn" Binding="{Binding Make}" Width="*" />
                                <DataGridTextColumn x:Name="VehicleModelColumn" Binding="{Binding Model}" Width="*" />
                                <DataGridTextColumn x:Name="VehicleEngineCodeColumn" Binding="{Binding EngineCode}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="VehicleFormTitle"
                                           DockPanel.Dock="Left"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="NewVehicleButton"
                                            Click="OnNewVehicleClick"
                                            Padding="14,8"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="RefreshVehiclesButton"
                                            Click="OnRefreshVehiclesClick"
                                            Padding="14,8"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="SaveVehicleButton"
                                            Click="OnSaveVehicleClick"
                                            Padding="14,8"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="White" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="VehicleMessage"
                                       Foreground="#7A3E00"
                                       FontSize="13"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="VehicleProfileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="VehicleProfileSelector"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnVehicleProfileChanged"
                                      Margin="0,4,0,12" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleMakeLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleMakeTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleModelLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleModelTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleYearLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleYearTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleFuelLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="VehicleFuelSelector" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleEngineLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleEngineTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleEngineCodeLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleEngineCodeTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="VehicleVinLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleVinTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="VehicleLicensePlateLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="VehicleLicensePlateTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock x:Name="VehicleNotesLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="VehicleNotesTextBox"
                                     MinHeight="92"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="EcusPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="3*" MinWidth="440" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuVehicleLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="EcuVehicleSelector"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnEcuVehicleChanged"
                                      Margin="0,4,0,12" />
                            <TextBlock x:Name="EcusListTitle"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <DataGrid x:Name="EcusGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="OnEcuSelectionChanged"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="EcuManufacturerColumn" Binding="{Binding Manufacturer}" Width="*" />
                                <DataGridTextColumn x:Name="EcuFamilyColumn" Binding="{Binding EcuFamily}" Width="*" />
                                <DataGridTextColumn x:Name="EcuSupportStatusColumn" Binding="{Binding SupportStatus}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock x:Name="EcuConfidenceText"
                                           DockPanel.Dock="Left"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="NewEcuButton"
                                            Click="OnNewEcuClick"
                                            Padding="14,8"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="RefreshEcusButton"
                                            Click="OnRefreshEcusClick"
                                            Padding="14,8"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="SaveEcuButton"
                                            Click="OnSaveEcuClick"
                                            Padding="14,8"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="White" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="EcuMessage"
                                       Foreground="#7A3E00"
                                       FontSize="13"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="EcuManufacturerLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="EcuManufacturerTextBox" TextChanged="OnEcuFieldChanged" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="EcuFamilyLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="EcuFamilyTextBox" TextChanged="OnEcuFieldChanged" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="EcuHardwareLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="EcuHardwareTextBox" TextChanged="OnEcuFieldChanged" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="EcuSoftwareLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="EcuSoftwareTextBox" TextChanged="OnEcuFieldChanged" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock x:Name="EcuSoftwareVersionLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="EcuSoftwareVersionTextBox" TextChanged="OnEcuFieldChanged" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock x:Name="EcuProtocolLabel" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="EcuProtocolTextBox" TextChanged="OnEcuFieldChanged" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock x:Name="EcuSupportStatusLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="EcuSupportStatusSelector"
                                      Margin="0,4,0,12"
                                      SelectionChanged="OnEcuFieldChanged" />

                            <TextBlock x:Name="EcuNotesLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="EcuNotesTextBox"
                                     MinHeight="92"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     TextChanged="OnEcuFieldChanged"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,4,0,12" />

                            <TextBlock x:Name="EcuMissingEvidenceText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="EcuFilesPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuFileVehicleLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="EcuFileVehicleSelector"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnEcuFileVehicleChanged"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuFileTypeLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="EcuFileTypeSelector" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuFileProgrammerLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="EcuFileProgrammerTextBox" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuFileSourceLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <DockPanel Margin="0,4,0,0">
                                <Button x:Name="SelectEcuFileButton"
                                        DockPanel.Dock="Right"
                                        Click="OnSelectEcuFileClick"
                                        Padding="14,8"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="EcuFileSourceTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuFileReadMethodLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="EcuFileReadMethodTextBox" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                            <TextBlock x:Name="EcuFileOriginLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="EcuFileOriginTextBox" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock x:Name="EcuFileNotesLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="EcuFileNotesTextBox" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button x:Name="RefreshEcuFilesButton"
                                    Click="OnRefreshEcuFilesClick"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button x:Name="ImportEcuFileButton"
                                    Click="OnImportEcuFileClick"
                                    Padding="14,8"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="EcuFilesListTitle"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="EcuFileMessage"
                                       Foreground="#7A3E00"
                                       FontSize="13"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <DataGrid x:Name="EcuFilesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="EcuFileNameColumn" Binding="{Binding FileName}" Width="2*" />
                                <DataGridTextColumn x:Name="EcuFileTypeColumn" Binding="{Binding FileType}" Width="*" />
                                <DataGridTextColumn x:Name="EcuFileSizeColumn" Binding="{Binding SizeBytes}" Width="*" />
                                <DataGridTextColumn x:Name="EcuFileHashColumn" Binding="{Binding Sha256Hash}" Width="3*" />
                                <DataGridTextColumn x:Name="EcuFileChecksumColumn" Binding="{Binding ChecksumStatus}" Width="*" />
                                <DataGridTextColumn x:Name="EcuFileImportedAtColumn" Binding="{Binding ImportedAt}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="ProgrammersPanel"
                    Grid.Row="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D6DEE6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="ProgrammersListTitle"
                               DockPanel.Dock="Top"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <DataGrid x:Name="ProgrammersGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ProgrammerNameColumn" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn x:Name="ProgrammerConnectionColumn" Binding="{Binding ConnectionType}" Width="*" />
                            <DataGridTextColumn x:Name="ProgrammerModeColumn" Binding="{Binding SupportedMode}" Width="*" />
                            <DataGridTextColumn x:Name="ProgrammerDirectReadColumn" Binding="{Binding DirectRead}" Width="*" />
                            <DataGridTextColumn x:Name="ProgrammerDirectWriteColumn" Binding="{Binding DirectWrite}" Width="*" />
                            <DataGridTextColumn x:Name="ProgrammerExternalSoftwareColumn" Binding="{Binding RequiresExternalSoftware}" Width="*" />
                            <DataGridTextColumn x:Name="ProgrammerNotesColumn" Binding="{Binding Notes}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid x:Name="ComparisonPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock x:Name="ComparisonVehicleLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="ComparisonVehicleSelector"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnComparisonVehicleChanged"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock x:Name="ComparisonOriginalFileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="ComparisonOriginalFileSelector"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,12">
                            <TextBlock x:Name="ComparisonModifiedFileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="ComparisonModifiedFileSelector"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="16,0,0,0">
                            <Button x:Name="RefreshComparisonsButton"
                                    Click="OnRefreshComparisonsClick"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button x:Name="RunComparisonButton"
                                    Click="OnRunComparisonClick"
                                    Padding="14,8"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="ComparisonResultsTitle"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ComparisonMessage"
                                       Foreground="#7A3E00"
                                       FontSize="13"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <DataGrid x:Name="ComparisonsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ComparisonOriginalColumn" Binding="{Binding OriginalFileId}" Width="2*" />
                                <DataGridTextColumn x:Name="ComparisonModifiedColumn" Binding="{Binding ModifiedFileId}" Width="2*" />
                                <DataGridTextColumn x:Name="ComparisonDifferencesColumn" Binding="{Binding DifferenceCount}" Width="*" />
                                <DataGridTextColumn x:Name="ComparisonPercentColumn" Binding="{Binding PercentChanged}" Width="*" />
                                <DataGridTextColumn x:Name="ComparisonOffsetsColumn" Binding="{Binding DifferenceSummary}" Width="4*" />
                                <DataGridTextColumn x:Name="ComparisonBlocksColumn" Binding="{Binding DifferenceBlockSummary}" Width="3*" />
                                <DataGridTextColumn x:Name="ComparisonResultColumn" Binding="{Binding Result}" Width="*" />
                                <DataGridTextColumn x:Name="ComparisonComparedAtColumn" Binding="{Binding ComparedAt}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="MapWorkspacePanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="#D6DEE6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock x:Name="MapWorkspaceVehicleLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="MapWorkspaceVehicleSelector"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnMapWorkspaceVehicleChanged"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock x:Name="MapWorkspaceFileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="MapWorkspaceFileSelector"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,12">
                            <TextBlock x:Name="MapWorkspaceModifiedFileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="MapWorkspaceModifiedFileSelector"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="9"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="16,0,0,12">
                            <Button x:Name="RefreshMapWorkspaceButton"
                                    Click="OnRefreshMapWorkspaceClick"
                                    MinWidth="96"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button x:Name="PreviewMapWorkspaceButton"
                                    Click="OnPreviewMapWorkspaceClick"
                                    MinWidth="96"
                                    Padding="14,8"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White" />
                            <Button x:Name="HexMapWorkspaceButton"
                                    Click="OnHexMapWorkspaceClick"
                                    MinWidth="96"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button x:Name="CompareMapWorkspaceButton"
                                    Click="OnCompareMapWorkspaceClick"
                                    MinWidth="96"
                                    Padding="14,8" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock x:Name="MapWorkspaceEcuLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="MapWorkspaceEcuSelector"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock x:Name="MapWorkspaceProfileLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="MapWorkspaceProfileSelector"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock x:Name="MapWorkspacePercentageLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspacePercentageTextBox"
                                     Text="0"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="9"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="16,0,0,0">
                            <Button x:Name="EvaluatePercentageIntentButton"
                                    Click="OnEvaluatePercentageIntentClick"
                                    MinWidth="120"
                                    Padding="14,8" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceOffsetLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspaceOffsetTextBox"
                                     Text="0"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceLengthLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspaceLengthTextBox"
                                     Text="128"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceMapIdLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspaceMapIdTextBox"
                                     Text="manual-map-1"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceMapNameLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspaceMapNameTextBox"
                                     Text="Manual candidate map"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="4" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceDataTypeLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="MapWorkspaceDataTypeSelector"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="6" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceRowsLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspaceRowsTextBox"
                                     Text="1"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="8" Margin="0,12,0,0">
                            <TextBlock x:Name="MapWorkspaceColumnsLabel" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="MapWorkspaceColumnsTextBox"
                                     Text="16"
                                     Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="9"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="16,12,0,0">
                            <Button x:Name="AddMapDefinitionButton"
                                    Click="OnAddMapDefinitionClick"
                                    MinWidth="120"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button x:Name="PreviewDefinedMapButton"
                                    Click="OnPreviewDefinedMapClick"
                                    MinWidth="120"
                                    Padding="14,8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#FFF7E6"
                        BorderBrush="#E2B96B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="MapWorkspaceStatusText"
                                   Foreground="#7A3E00"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="MapWorkspaceEditGateText"
                                   Foreground="#7A3E00"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="420" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="#D6DEE6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <DockPanel>
                            <TextBlock x:Name="MapWorkspaceChartTitle"
                                       DockPanel.Dock="Top"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <Canvas x:Name="MapWorkspaceChartCanvas"
                                    Height="280"
                                    Background="#F4F6F8"
                                    ClipToBounds="True" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="#D6DEE6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <DockPanel>
                            <TextBlock x:Name="MapWorkspaceTableTitle"
                                       DockPanel.Dock="Top"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <DataGrid x:Name="MapWorkspaceGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="MapWorkspaceOffsetColumn" Binding="{Binding Offset}" Width="*" />
                                    <DataGridTextColumn x:Name="MapWorkspaceOriginalHexColumn" Binding="{Binding OriginalHex}" Width="*" />
                                    <DataGridTextColumn x:Name="MapWorkspaceModifiedHexColumn" Binding="{Binding ModifiedHex}" Width="*" />
                                    <DataGridTextColumn x:Name="MapWorkspaceDeltaColumn" Binding="{Binding Difference}" Width="*" />
                                    <DataGridTextColumn x:Name="MapWorkspaceRawColumn" Binding="{Binding RawValue}" Width="*" />
                                    <DataGridTextColumn x:Name="MapWorkspaceScaledColumn" Binding="{Binding ScaledValue}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="ReportsPanel"
                    Grid.Row="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D6DEE6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ReportComparisonLabel" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="ReportComparisonSelector"
                              DisplayMemberPath="DisplayName"
                              Margin="0,4,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Button x:Name="RefreshReportsButton"
                                Click="OnRefreshReportsClick"
                                Padding="14,8"
                                Margin="0,0,8,0" />
                        <Button x:Name="GenerateReportButton"
                                Click="OnGenerateReportClick"
                                Padding="14,8"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White" />
                    </StackPanel>

                    <TextBlock x:Name="ReportOutputLabel"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="ReportOutputTextBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MinHeight="90" />
                    <TextBlock x:Name="ReportMessage"
                               Foreground="#7A3E00"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="SafeModeFooter"
                       Grid.Row="2"
                       Foreground="#7A3E00"
                       FontSize="13"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
