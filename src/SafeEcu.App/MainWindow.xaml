<Window x:Class="SafeEcu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Safe ECU Calibration Manager"
        Height="720"
        MinHeight="620"
        Width="1120"
        MinWidth="980"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17202A">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="Safe ECU"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Calibration Manager"
                               Foreground="#C9D3DC"
                               FontSize="14"
                               Margin="0,2,0,0" />
                </StackPanel>

                <ItemsControl x:Name="NavigationItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Tag="{Binding Area}"
                                    Click="OnNavigationClick"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,10"
                                    Margin="0,0,0,8"
                                    Background="#22303C"
                                    Foreground="White"
                                    BorderBrush="#344756"
                                    BorderThickness="1"
                                    Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock x:Name="SectionTitle"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SectionDescription"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="15"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D6DEE6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SectionStatus"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <TextBlock x:Name="SectionBody"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Modo seguro: FileOnly / ManualWorkflow. Escrita ECU e controlo direto de hardware estao desativados."
                       Foreground="#7A3E00"
                       FontSize="13"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
